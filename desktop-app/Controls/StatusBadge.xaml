<UserControl x:Class="FoodWasteRelief.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="22"
             MinWidth="56">
    <Border x:Name="BadgeBorder"
            CornerRadius="4"
            Padding="8,3"
            Background="#FFF3CD"
            BorderBrush="#E0E0E0"
            BorderThickness="0">
        <TextBlock x:Name="BadgeText"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#856404"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>
