<Window x:Class="FoodWasteRelief.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:FoodWasteRelief.Controls"
        mc:Ignorable="d"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterScreen"
        Title="FoodWaste Relief"
        Height="760" Width="1240"
        MinWidth="1024" MinHeight="680">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2" Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Leaf" Width="24" Height="24" Foreground="{StaticResource SidebarAccentBrush}"/>
                        <TextBlock Text="FoodWaste Relief" Margin="8,0,0,0" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{StaticResource SidebarHoverBrush}" Margin="0,16,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="10,8,10,0">
                    <Button x:Name="NavDashboard" Style="{StaticResource MaterialDesignFlatButton}" Click="NavDashboard_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ViewDashboard"/><TextBlock Text=" Tableau de bord"/></StackPanel>
                    </Button>
                    <Button x:Name="NavCatalog" Visibility="Collapsed" Style="{StaticResource MaterialDesignFlatButton}" Click="NavCatalog_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ShoppingSearch"/><TextBlock Text=" Catalogue"/></StackPanel>
                    </Button>
                    <Button x:Name="NavCart" Visibility="Collapsed" Style="{StaticResource MaterialDesignFlatButton}" Click="NavCart_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Cart"/><TextBlock Text=" Panier"/></StackPanel>
                    </Button>
                    <Button x:Name="NavUsers" Style="{StaticResource MaterialDesignFlatButton}" Click="NavUsers_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountGroup"/><TextBlock Text=" Utilisateurs"/></StackPanel>
                    </Button>
                    <Button x:Name="NavBusinesses" Style="{StaticResource MaterialDesignFlatButton}" Click="NavBusinesses_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Storefront"/><TextBlock Text=" Etablissements"/></StackPanel>
                            <Border x:Name="BusinessPendingBadge" Background="{StaticResource DangerBrush}" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" Visibility="Collapsed">
                                <TextBlock x:Name="BusinessPendingBadgeText" Foreground="White" FontSize="10"/>
                            </Border>
                        </DockPanel>
                    </Button>
                    <Button x:Name="NavAssociations" Style="{StaticResource MaterialDesignFlatButton}" Click="NavAssociations_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="HandHeart"/><TextBlock Text=" Associations"/></StackPanel>
                            <Border x:Name="AssocPendingBadge" Background="{StaticResource DangerBrush}" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" Visibility="Collapsed">
                                <TextBlock x:Name="AssocPendingBadgeText" Foreground="White" FontSize="10"/>
                            </Border>
                        </DockPanel>
                    </Button>
                    <Button x:Name="NavProducts" Style="{StaticResource MaterialDesignFlatButton}" Click="NavProducts_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FoodApple"/><TextBlock Text=" Produits"/></StackPanel>
                    </Button>
                    <Button x:Name="NavOrders" Style="{StaticResource MaterialDesignFlatButton}" Click="NavOrders_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CartOutline"/><TextBlock Text=" Commandes"/></StackPanel>
                    </Button>
                    <Button x:Name="NavDonations" Style="{StaticResource MaterialDesignFlatButton}" Click="NavDonations_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="HeartOutline"/><TextBlock Text=" Dons"/></StackPanel>
                    </Button>
                    <Button x:Name="NavStorage" Style="{StaticResource MaterialDesignFlatButton}" Click="NavStorage_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ArchiveOutline"/><TextBlock Text=" Stockage"/></StackPanel>
                    </Button>
                    <Button x:Name="NavContact" Style="{StaticResource MaterialDesignFlatButton}" Click="NavContact_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="EmailOutline"/><TextBlock Text=" Contact"/></StackPanel>
                            <Border x:Name="ContactUnreadBadge" Background="{StaticResource DangerBrush}" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" Visibility="Collapsed">
                                <TextBlock x:Name="ContactUnreadBadgeText" Foreground="White" FontSize="10"/>
                            </Border>
                        </DockPanel>
                    </Button>
                    <Button x:Name="NavActivity" Style="{StaticResource MaterialDesignFlatButton}" Click="NavActivity_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="History"/><TextBlock Text=" Activité"/></StackPanel>
                    </Button>
                    <Button x:Name="NavStatistics" Style="{StaticResource MaterialDesignFlatButton}" Click="NavStatistics_Click" Foreground="White" HorizontalContentAlignment="Left" Padding="12,10">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ChartBar"/><TextBlock Text=" Statistiques"/></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,20">
                    <Rectangle Height="1" Fill="{StaticResource SidebarHoverBrush}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UserRoleText" Foreground="{StaticResource SidebarAccentBrush}" FontSize="12"/>
                    <Button Margin="0,10,0,0" Click="Logout_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White">
                        Deconnexion
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon x:Name="PageIcon" Kind="ViewDashboard" Foreground="{StaticResource PrimaryBrush}" Width="22" Height="22"/>
                    <TextBlock x:Name="PageTitleText" Text="Tableau de bord" Margin="10,0,0,0" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0"/>
                    <Grid>
                        <materialDesign:PackIcon Kind="Bell" Width="20" Height="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Border x:Name="NotifBadge" Width="16" Height="16" CornerRadius="8" Background="{StaticResource DangerBrush}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,-6,0,0">
                            <TextBlock x:Name="NotifCount" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame"
               Grid.Row="1"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="{StaticResource PageBackgroundBrush}"/>

        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False">
            <controls:ToastHost x:Name="ToastHost"/>
        </Grid>
    </Grid>
</Window>
