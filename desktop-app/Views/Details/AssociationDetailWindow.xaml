<Window x:Class="FoodWasteRelief.Views.Details.AssociationDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FoodWasteRelief.Controls"
        Title="Détail association"
        Style="{StaticResource AppWindow}"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight">
    <Grid Margin="18">
        <Border BorderBrush="#D9DEE3" BorderThickness="1" CornerRadius="8" Background="White" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Association" Foreground="#6C757D"/>
                <TextBlock Grid.Column="1" x:Name="NameText" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="Ville" Foreground="#6C757D" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VilleText" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="2" Text="Téléphone" Foreground="#6C757D" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PhoneText" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="3" Text="Statut" Foreground="#6C757D" Margin="0,8,0,0"/>
                <controls:StatusBadge Grid.Row="3" Grid.Column="1" x:Name="StatusBadge" Margin="0,8,0,0"/>
            </Grid>
        </Border>
        <Button Content="Fermer" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="120" Margin="0,12,0,0" Click="Close_Click"/>
    </Grid>
</Window>
