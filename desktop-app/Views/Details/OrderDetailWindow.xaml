<Window x:Class="FoodWasteRelief.Views.Details.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FoodWasteRelief.Controls"
        Title="D�tail commande"
        Style="{StaticResource AppWindow}" MinWidth="700" MinHeight="480" WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#D9DEE3" BorderThickness="1" CornerRadius="8" Background="White" Padding="18" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Client" Foreground="#6C757D"/><TextBlock Grid.Column="1" x:Name="ClientText" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="�tablissement" Foreground="#6C757D" Margin="0,8,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="BusinessText" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="2" Text="Date" Foreground="#6C757D" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="DateText" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="3" Text="Statut" Foreground="#6C757D" Margin="0,8,0,0"/><controls:StatusBadge Grid.Row="3" Grid.Column="1" x:Name="StatusBadge" Margin="0,8,0,0"/>
            </Grid>
        </Border>
        <DataGrid Grid.Row="2" x:Name="LinesGrid" Style="{StaticResource AppDataGrid}" AutoGenerateColumns="False" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produit" Binding="{Binding ProduitNom}" Width="*"/>
                <DataGridTextColumn Header="Quantit�" Binding="{Binding Quantite}" Width="90"/>
                <DataGridTextColumn Header="Prix unit." Binding="{Binding PrixUnitaire, StringFormat={}{0:F2} TND}" Width="120"/>
                <DataGridTextColumn Header="Sous-total" Binding="{Binding Total, StringFormat={}{0:F2} TND}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock x:Name="TotalText" FontSize="16" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="ConfirmBtn" Content="Accepter" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="ConfirmBtn_Click"/>
                <Button x:Name="CancelBtn" Content="Rejeter" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="CancelBtn_Click"/>
                <Button x:Name="DeliverBtn" Content="Marquer livr�" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="DeliverBtn_Click"/>
                <Button Content="Fermer" Style="{StaticResource OutlineButton}" Width="120" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
