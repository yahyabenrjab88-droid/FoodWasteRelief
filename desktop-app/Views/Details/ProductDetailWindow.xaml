<Window x:Class="FoodWasteRelief.Views.Details.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FoodWasteRelief.Controls"
        Title="D�tail produit"
        Style="{StaticResource AppWindow}" MinWidth="560" MinHeight="470" WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#D9DEE3" BorderThickness="1" CornerRadius="8" Background="White" Padding="18" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Produit" Foreground="#6C757D"/><TextBlock Grid.Column="1" x:Name="NameText" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="�tablissement" Foreground="#6C757D" Margin="0,8,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="BusinessText" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="2" Text="Cat�gorie" Foreground="#6C757D" Margin="0,8,0,0"/><controls:StatusBadge Grid.Row="2" Grid.Column="1" x:Name="CategoryBadge" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="3" Text="Prix" Foreground="#6C757D" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="PriceText" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="4" Text="Quantit�" Foreground="#6C757D" Margin="0,8,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="QtyText" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="5" Text="Expiration" Foreground="#6C757D" Margin="0,8,0,0"/><TextBlock Grid.Row="5" Grid.Column="1" x:Name="ExpText" FontWeight="SemiBold" Margin="0,8,0,0"/>
            </Grid>
        </Border>
        <TextBox Grid.Row="1" x:Name="DescText" IsReadOnly="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="-" Width="34" Height="34" Click="Minus_Click"/>
                <TextBlock x:Name="QtyPickText" Width="40" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Content="+" Width="34" Height="34" Click="Plus_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="AddToCartBtn" Content="Ajouter au panier" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="AddToCartBtn_Click"/>
                <Button Content="Fermer" Style="{StaticResource OutlineButton}" Width="120" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
