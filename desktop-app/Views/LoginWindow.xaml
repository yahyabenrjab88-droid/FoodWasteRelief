<Window x:Class="FoodWasteRelief.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Height="680" Width="1020"
        MinWidth="1024" MinHeight="680"
        Title="FoodWaste Relief — Account">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Hero -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="FoodWaste Relief"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="Fighting food waste, one meal at a time"
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#DDEDE4"/>
                </StackPanel>

                <Canvas Grid.Row="1" Margin="0,24,0,24" Opacity="0.35">
                    <Ellipse Width="18" Height="18" Fill="{StaticResource AccentBrush}" Canvas.Left="24" Canvas.Top="32"/>
                    <Ellipse Width="10" Height="10" Fill="{StaticResource WarningBrush}" Canvas.Left="180" Canvas.Top="70"/>
                    <Ellipse Width="26" Height="26" Fill="{StaticResource SecondaryBrush}" Canvas.Left="90" Canvas.Top="140"/>
                    <Ellipse Width="14" Height="14" Fill="{StaticResource AccentBrush}" Canvas.Left="220" Canvas.Top="210"/>
                    <Ellipse Width="22" Height="22" Fill="{StaticResource WarningBrush}" Canvas.Left="40" Canvas.Top="250"/>
                </Canvas>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="ESEN • PFA 2025/2026 • SDG 12"
                               Foreground="#CFE6DA"
                               FontSize="12"/>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#CFE6DA" FontSize="12"
                               Text="Log in: existing accounts. Sign in: new Client or Business — admin is invite-only."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Account panel -->
        <Grid Grid.Column="1" Margin="36,28,36,20">
            <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Center">
                <Grid>
                    <TabControl x:Name="MainAccountTabs" Padding="8,4,8,8" Background="Transparent">
                        <!-- Existing users -->
                        <TabItem Header="Log in">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                <StackPanel Margin="20,12,20,16">
                                    <TextBlock Text="Existing account"
                                               FontSize="22" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Use the email and password you already have."
                                               Margin="0,4,0,16"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>

                                    <TextBox x:Name="EmailBox"
                                             materialDesign:HintAssist.Hint="Email"
                                             Margin="0,0,0,10" Height="44" FontSize="14"/>
                                    <PasswordBox x:Name="PasswordBox"
                                                 materialDesign:HintAssist.Hint="Password"
                                                 Margin="0,0,0,8" Height="44" FontSize="14"/>
                                    <CheckBox x:Name="RememberMeBox" Content="Remember me" Margin="0,0,0,8"/>

                                    <TextBlock x:Name="LogInErrorText" Margin="0,8,0,0"
                                               Foreground="{StaticResource DangerBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <Button x:Name="BtnLogIn" Margin="0,16,0,0" Height="46"
                                            Background="{StaticResource PrimaryBrush}"
                                            Foreground="White" FontWeight="SemiBold"
                                            Click="BtnLogIn_Click">
                                        <Grid>
                                            <TextBlock x:Name="BtnLogInLabel" Text="Log in" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <ProgressBar x:Name="LogInProgress" IsIndeterminate="True" Visibility="Collapsed"
                                                         Height="3" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Button>

                                    <TextBlock Margin="0,14,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12">
                                        <Run Text="Demo: "/>
                                        <Run FontWeight="SemiBold">admin.role@fwr.local</Run><Run Text=" / passadmin · "/>
                                        <Run FontWeight="SemiBold">business.role@fwr.local</Run><Run Text=" / passbusiness · "/>
                                        <Run FontWeight="SemiBold">client.role@fwr.local</Run><Run Text=" / passclient"/>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- New users: choose role (not admin) -->
                        <TabItem Header="Sign in">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                <StackPanel Margin="20,12,20,16">
                                    <TextBlock Text="New account"
                                               FontSize="22" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,8"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        Choose <Run FontWeight="SemiBold">Client</Run>, <Run FontWeight="SemiBold">Business</Run>, or <Run FontWeight="SemiBold">Association</Run>.
                                        Administrator accounts are not available here.
                                    </TextBlock>

                                    <TextBlock Text="I am a:" FontWeight="SemiBold" Margin="0,8,0,6"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton x:Name="RoleClientRadio" GroupName="NewUserRole" Content="Client" IsChecked="True" Margin="0,0,20,0"/>
                                        <RadioButton x:Name="RoleBusinessRadio" GroupName="NewUserRole" Content="Business" Margin="0,0,20,0"/>
                                        <RadioButton x:Name="RoleAssociationRadio" GroupName="NewUserRole" Content="Association"/>
                                    </StackPanel>

                                    <TextBox x:Name="RegEmailBox" materialDesign:HintAssist.Hint="Email"
                                             Margin="0,0,0,10" Height="44" FontSize="14"/>
                                    <PasswordBox x:Name="RegPasswordBox" materialDesign:HintAssist.Hint="Password"
                                                 Margin="0,0,0,10" Height="44" FontSize="14"/>
                                    <PasswordBox x:Name="RegConfirmPasswordBox" materialDesign:HintAssist.Hint="Confirm password"
                                                 Margin="0,0,0,10" Height="44" FontSize="14"/>
                                    <TextBox x:Name="RegPrenomBox" materialDesign:HintAssist.Hint="Prénom"
                                             Margin="0,0,0,10" Height="44" FontSize="14"/>
                                    <TextBox x:Name="RegNomBox" materialDesign:HintAssist.Hint="Nom"
                                             Margin="0,0,0,10" Height="44" FontSize="14"/>
                                    <TextBox x:Name="RegTelephoneBox" materialDesign:HintAssist.Hint="Téléphone"
                                             Margin="0,0,0,10" Height="44" FontSize="14"/>

                                    <TextBlock x:Name="SignInErrorText" Margin="0,4,0,0"
                                               Foreground="{StaticResource DangerBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <Button x:Name="BtnSignInNew" Margin="0,16,0,0" Height="46"
                                            Background="{StaticResource AccentBrush}"
                                            Foreground="White" FontWeight="SemiBold"
                                            Click="BtnSignInNew_Click">
                                        <Grid>
                                            <TextBlock x:Name="BtnSignInNewLabel" Text="Sign in" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <ProgressBar x:Name="SignInProgress" IsIndeterminate="True" Visibility="Collapsed"
                                                         Height="3" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <TextBlock VerticalAlignment="Bottom" Margin="4,0,4,0"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                       Text="Tip: start XAMPP (MySQL) before using the app."/>
        </Grid>
    </Grid>
</Window>
