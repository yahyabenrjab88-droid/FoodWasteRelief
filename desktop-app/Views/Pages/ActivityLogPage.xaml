<Page x:Class="FoodWasteRelief.Views.Pages.ActivityLogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchBox" Width="280" Style="{StaticResource ModernTextBox}" TextChanged="SearchBox_TextChanged"/>
                    <Button Content="Actualiser" Style="{StaticResource OutlineButton}" Margin="12,0,0,0" Click="RefreshBtn_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <DataGrid x:Name="GridLogs" Style="{StaticResource AppDataGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                    <DataGridTextColumn Header="Utilisateur" Binding="{Binding Username}" Width="160"/>
                    <DataGridTextColumn Header="Rôle" Binding="{Binding UserRole}" Width="100"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200"/>
                    <DataGridTextColumn Header="Détails" Binding="{Binding Details}" Width="*"/>
                    <DataGridTemplateColumn Header="Actions" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Consulter" Tag="{Binding Id}" Style="{DynamicResource ConsulterButton}" Padding="8,4" Click="ViewLog_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
