<Page x:Class="FoodWasteRelief.Views.Pages.DonationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:FoodWasteRelief.Controls"
      Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="ErrorBanner" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,10" Padding="12,8"
                Background="#F8D7DA" BorderBrush="#F5C2C7" BorderThickness="1" CornerRadius="6">
            <TextBlock x:Name="ErrorBannerText" Foreground="#842029" TextWrapping="Wrap"/>
        </Border>

        <Border x:Name="CreateDonationPanel" Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Créer un don (depuis le stock)" Style="{StaticResource SectionHeader}"/>
                <WrapPanel>
                    <ComboBox x:Name="StorageBox" Width="360" Style="{StaticResource ModernComboBox}" DisplayMemberPath="ComboLabel"/>
                    <ComboBox x:Name="AssociationBox" Width="260" Margin="12,0,0,0" Style="{StaticResource ModernComboBox}" DisplayMemberPath="Nom"/>
                    <TextBox x:Name="QtyBox" Width="80" Margin="12,0,0,0" Text="1" Style="{StaticResource ModernTextBox}"/>
                    <Button x:Name="CreateDonationBtn" Content="Ajouter don" Style="{StaticResource AccentButton}" Margin="12,0,0,0" Click="CreateDonation_Click"/>
                    <Button Content="Actualiser" Style="{StaticResource OutlineButton}" Margin="12,0,0,0" Click="RefreshBtn_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border x:Name="AssociationFilterPanel" Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filtrer :" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox x:Name="AssociationStatusFilter" Width="200" Style="{StaticResource ModernComboBox}" SelectionChanged="AssociationStatusFilter_SelectionChanged">
                    <ComboBoxItem Content="Tous" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Acceptés" Tag="Accepted"/>
                    <ComboBoxItem Content="Collectés" Tag="Collected"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <DataGrid x:Name="GridDonations" Style="{StaticResource AppDataGrid}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Établissement" Binding="{Binding BusinessNom}" Width="180"/>
                    <DataGridTextColumn Header="Article (stock)" Binding="{Binding ProduitNom}" Width="*"/>
                    <DataGridTextColumn Header="Association" Binding="{Binding AssociationNom}" Width="160"/>
                    <DataGridTextColumn Header="Quantité" Binding="{Binding Quantite}" Width="90"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateDonation, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                    <DataGridTemplateColumn Header="Statut" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:StatusBadge Status="{Binding Status}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="370">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Tag="{Binding Id}" Content="Consulter" Margin="0,0,6,0" Style="{DynamicResource ConsulterButton}" Padding="8,4"
                                            Click="ViewDonation_Click"/>
                                    <Button Tag="{Binding Id}" Content="Accepter" Margin="0,0,6,0" Style="{DynamicResource PrimaryButton}" Padding="8,4"
                                            Visibility="{Binding ShowAdminAcceptReject, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Click="AcceptDonation_Click"/>
                                    <Button Tag="{Binding Id}" Content="Rejeter" Margin="0,0,6,0" Style="{DynamicResource OutlineButton}" Padding="8,4"
                                            Visibility="{Binding ShowAdminAcceptReject, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Click="RejectDonation_Click"/>
                                    <Button Tag="{Binding Id}" Content="Marquer collecté" Margin="0,0,6,0" Style="{DynamicResource PrimaryButton}" Padding="8,4"
                                            Visibility="{Binding ShowAssociationCollect, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Click="MarkCollected_Click"/>
                                    <Button Tag="{Binding Id}" Content="Supprimer" Style="{DynamicResource DangerButton}" Padding="8,4"
                                            Visibility="{Binding ShowDeleteDonation, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Click="Delete_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
