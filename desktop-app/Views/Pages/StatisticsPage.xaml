<Page x:Class="FoodWasteRelief.Views.Pages.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Statistiques" Style="{StaticResource SectionHeader}"/>
                    <WrapPanel>
                        <Border Style="{StaticResource CardBorder}" Width="220" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="Utilisateurs"/><TextBlock x:Name="UsersCountText" FontSize="28"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Width="220" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="Produits"/><TextBlock x:Name="ProductsCountText" FontSize="28"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Width="220" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="Dons"/><TextBlock x:Name="DonationsCountText" FontSize="28"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Width="220">
                            <StackPanel><TextBlock Text="Revenu (livree)"/><TextBlock x:Name="RevenueText" FontSize="28"/></StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock x:Name="NoDataText" Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" Text="No data yet"/>
                </StackPanel>
            </Border>

            <!-- ADMIN — Impact Global -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Banner -->
                    <Border Background="#2D6A4F" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding TickerText}" Foreground="White" FontSize="20" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TickerSubText}" Foreground="#A8D5B5" FontSize="14" Margin="0,8,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="Impact Global" Style="{StaticResource SectionHeader}"/>

                    <!-- Error + Retry -->
                    <Border Grid.Row="2" Background="#F8D7DA" BorderBrush="#F5C2C7" BorderThickness="1" CornerRadius="6" Padding="12,8"
                            Visibility="{Binding ImpactError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock Text="{Binding ImpactErrorText}" Foreground="#842029" TextWrapping="Wrap" DockPanel.Dock="Left"/>
                            <Button Content="Réessayer" Style="{StaticResource OutlineButton}" DockPanel.Dock="Right" Margin="12,0,0,0" Click="RetryImpact_Click"/>
                        </DockPanel>
                    </Border>

                    <!-- Empty state -->
                    <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16" Background="White"
                            Visibility="{Binding ImpactEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Aucune donnée d'impact pour l'instant. Les statistiques apparaîtront dès que des ventes ou dons seront enregistrés."
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="14"/>
                    </Border>

                    <!-- Stat cards -->
                    <WrapPanel Grid.Row="3" Margin="0,12,0,12" Visibility="{Binding ImpactEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <!-- Card template: white, 8px radius, border #E0E0E0 -->
                        <Border Width="210" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalKg, StringFormat={}{0:0.#} kg}" FontSize="28" FontWeight="Bold" Foreground="#2D6A4F"/>
                                    <TextBlock Text="kg sauvés du gaspillage" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#2D6A4F" StrokeThickness="2" Fill="Transparent"
                                              Data="M12,2 C6,6 5,12 5,18 C11,19 18,15 20,8 C16,7 14,5 12,2 Z"/>
                                        <Path Stroke="#2D6A4F" StrokeThickness="2" Fill="Transparent" Data="M9,14 C11,12 14,10 18,8"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <Border Width="210" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Meals}" FontSize="28" FontWeight="Bold" Foreground="#52B788"/>
                                    <TextBlock Text="repas estimés sauvés" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Stroke="#52B788" StrokeThickness="2" Width="18" Height="18" Canvas.Left="3" Canvas.Top="3"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <Border Width="210" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Co2, StringFormat={}{0:0.#}}" FontSize="28" FontWeight="Bold" Foreground="#1B4332"/>
                                    <TextBlock Text="kg CO2 évités" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#1B4332" StrokeThickness="2" Fill="Transparent"
                                              Data="M7,16 C4,16 3,14 3,12 C3,10 5,9 7,9 C8,6 10,5 12,5 C15,5 17,7 17,10 C19,10 21,11 21,13 C21,15 20,16 18,16 Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <Border Width="210" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DonationsAcceptedCount}" FontSize="28" FontWeight="Bold" Foreground="#52B788"/>
                                    <TextBlock Text="dons validés" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#52B788" StrokeThickness="2" Fill="Transparent"
                                              Data="M12,20 C12,20 4,14 4,9 C4,6.5 6,5 8,5 C9.5,5 11,6 12,7.5 C13,6 14.5,5 16,5 C18,5 20,6.5 20,9 C20,14 12,20 12,20 Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <Border Width="210" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding OrdersCompletedCount}" FontSize="28" FontWeight="Bold" Foreground="#2D6A4F"/>
                                    <TextBlock Text="commandes traitées" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Stroke="#2D6A4F" StrokeThickness="2" Width="18" Height="18" Canvas.Left="3" Canvas.Top="3"/>
                                        <Path Stroke="#2D6A4F" StrokeThickness="2" Data="M7,12 L11,16 L17,8"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <Border Width="210" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveBusinesses}" FontSize="28" FontWeight="Bold" Foreground="#1B4332"/>
                                    <TextBlock Text="entreprises participantes" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#1B4332" StrokeThickness="2" Fill="Transparent"
                                              Data="M6,20 L6,6 L12,3 L18,6 L18,20 Z"/>
                                        <Path Stroke="#1B4332" StrokeThickness="2" Data="M9,10 L9,10 M9,14 L9,14 M15,10 L15,10 M15,14 L15,14"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </WrapPanel>

                    <!-- Charts row 1 -->
                    <Grid Grid.Row="4" Margin="0,0,0,12" Visibility="{Binding ImpactEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Évolution des kg sauvés — toute la plateforme" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Canvas x:Name="ImpactMonthlyCanvas" Height="240"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="■" Foreground="#2D6A4F" Margin="0,0,6,0"/><TextBlock Text="Dons" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                                    <TextBlock Text="■" Foreground="#52B788" Margin="0,0,6,0"/><TextBlock Text="Ventes" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                                    <TextBlock Text="---" Foreground="Black" Margin="0,0,6,0"/><TextBlock Text="Total" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Origine globale des kg sauvés" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Canvas x:Name="ImpactSplitCanvas" Height="70"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="■" Foreground="#2D6A4F" Margin="0,0,6,0"/><TextBlock Text="Dons" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                                    <TextBlock Text="■" Foreground="#52B788" Margin="0,0,6,0"/><TextBlock Text="Ventes" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Charts row 2 — Leaderboards -->
                    <Grid Margin="0,0,0,12" Visibility="{Binding ImpactEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Top 5 entreprises — kg sauvés" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Canvas x:Name="TopBizCanvas" Height="160"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Top 5 associations — kg collectés" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Canvas x:Name="TopAssocCanvas" Height="160"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Breakdown table -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16"
                            Visibility="{Binding ImpactEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Détail par entreprise" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <DataGrid x:Name="ImpactBusinessesGrid" Style="{StaticResource AppDataGrid}" AutoGenerateColumns="False" CanUserSortColumns="True"
                                      ItemsSource="{Binding BusinessRows}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopPerformer}" Value="True">
                                                <Setter Property="Background" Value="#FFFDE7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTotals}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Entreprise" Binding="{Binding BusinessName}" Width="200"/>
                                    <DataGridTextColumn Header="Kg donnés" Binding="{Binding KgDonated, StringFormat={}{0:0.#}}" Width="90"/>
                                    <DataGridTextColumn Header="Kg vendus" Binding="{Binding KgSold, StringFormat={}{0:0.#}}" Width="90"/>
                                    <DataGridTextColumn Header="Total kg sauvés" Binding="{Binding TotalKg, StringFormat={}{0:0.#}}" Width="110"/>
                                    <DataGridTextColumn Header="Repas estimés" Binding="{Binding Meals}" Width="95"/>
                                    <DataGridTextColumn Header="CO2 évité (kg)" Binding="{Binding Co2, StringFormat={}{0:0.#}}" Width="110"/>
                                    <DataGridTextColumn Header="Dons effectués" Binding="{Binding DonationsCount}" Width="95"/>
                                    <DataGridTextColumn Header="Commandes" Binding="{Binding OrdersCount}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Aucune donnée disponible." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"
                                       Visibility="{Binding BusinessRows.Count, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Loading overlay -->
                    <Border Background="#80FFFFFF" CornerRadius="8" Visibility="{Binding ImpactLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="220" Height="6" IsIndeterminate="True"/>
                            <TextBlock Text="Chargement des statistiques d'impact..." Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

