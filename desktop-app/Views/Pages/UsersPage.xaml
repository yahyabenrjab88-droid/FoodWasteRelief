<Page x:Class="FoodWasteRelief.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="UsersErrorBanner" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,10" Padding="12,8"
                Background="#F8D7DA" BorderBrush="#F5C2C7" BorderThickness="1" CornerRadius="6">
            <TextBlock x:Name="UsersErrorText" Foreground="#842029" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <DockPanel LastChildFill="False">
                <TextBox x:Name="SearchBox" Width="300" Style="{StaticResource ModernTextBox}" materialDesign:HintAssist.Hint="Rechercher par nom / email" TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="RoleFilterBox" Width="180" Margin="12,0,0,0" Style="{StaticResource ModernComboBox}" SelectionChanged="RoleFilterBox_SelectionChanged">
                    <ComboBoxItem Content="Tous les roles" IsSelected="True"/>
                    <ComboBoxItem Content="admin"/>
                    <ComboBoxItem Content="business"/>
                    <ComboBoxItem Content="client"/>
                    <ComboBoxItem Content="association"/>
                </ComboBox>
                <Button Content="Actualiser" Style="{StaticResource OutlineButton}" Margin="12,0,0,0" Click="RefreshBtn_Click"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <DataGrid x:Name="GridUsers" Style="{StaticResource AppDataGrid}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom complet" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>
                    <DataGridTextColumn Header="Telephone" Binding="{Binding Telephone}" Width="130"/>
                    <DataGridTextColumn Header="Inscrit le" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="130"/>
                    <DataGridTemplateColumn Header="Actions" Width="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Tag="{Binding Id}" Content="Consulter" Style="{DynamicResource ConsulterButton}" Margin="0,0,6,0" Padding="8,4" Click="ViewUser_Click"/>
                                    <Button Tag="{Binding Id}" Content="Suppr." Style="{DynamicResource DangerButton}" Padding="8,4" Click="DeleteUser_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>

