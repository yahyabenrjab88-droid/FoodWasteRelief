<Page x:Class="FoodWasteRelief.Views.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Mon panier" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <DataGrid x:Name="GridCart" Style="{StaticResource AppDataGrid}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Établissement" Binding="{Binding BusinessName}" Width="160"/>
                    <DataGridTextColumn Header="Produit" Binding="{Binding ProduitNom}" Width="*"/>
                    <DataGridTextColumn Header="Prix unit." Binding="{Binding PrixUnitaire, StringFormat={}{0:F2} TND}" Width="110"/>
                    <DataGridTemplateColumn Header="Quantité" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="−" Width="32" Height="32" Padding="0" Style="{DynamicResource OutlineButton}"
                                            Tag="{Binding CartItemId}" Click="Minus_Click"/>
                                    <TextBlock Text="{Binding Quantite}" VerticalAlignment="Center" Margin="10,0" MinWidth="24" TextAlignment="Center"/>
                                    <Button Content="+" Width="32" Height="32" Padding="0" Style="{DynamicResource OutlineButton}"
                                            Tag="{Binding CartItemId}" Click="Plus_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Sous-total" Binding="{Binding SousTotal, StringFormat={}{0:F2} TND}" Width="120"/>
                    <DataGridTemplateColumn Header="" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Consulter" Style="{DynamicResource ConsulterButton}" Padding="8,4" Margin="0,0,6,0"
                                            Tag="{Binding ProduitId}" Click="ViewProduct_Click"/>
                                    <Button Content="Retirer" Style="{DynamicResource DangerButton}" Padding="8,4"
                                            Tag="{Binding CartItemId}" Click="Remove_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="16">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TotalText" DockPanel.Dock="Left" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Actualiser" Style="{StaticResource OutlineButton}" Margin="0,0,10,0" Click="RefreshBtn_Click"/>
                    <Button Content="Commander" Style="{StaticResource PrimaryButton}" Click="Checkout_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
