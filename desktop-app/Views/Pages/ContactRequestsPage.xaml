<Page x:Class="FoodWasteRelief.Views.Pages.ContactRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="ComposePanel" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Contacter admin" Style="{StaticResource SectionHeader}"/>
                <WrapPanel>
                    <ComboBox x:Name="SubjectBox" Width="220" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="Question"/>
                        <ComboBoxItem Content="Report"/>
                        <ComboBoxItem Content="Complaint"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>
                    <TextBox x:Name="BodyBox" Width="480" Height="70" Margin="12,0,0,0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="Envoyer" Style="{StaticResource AccentButton}" Margin="12,0,0,0" Click="Send_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,10,0,10">
            <DockPanel>
                <TextBlock Text="Messages" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left"/>
                <TextBlock x:Name="UnreadText" DockPanel.Dock="Right" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <DataGrid x:Name="GridRequests" Style="{StaticResource AppDataGrid}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="De" Binding="{Binding SenderName}" Width="170"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding SenderRole}" Width="110"/>
                    <DataGridTextColumn Header="Sujet" Binding="{Binding Subject}" Width="180"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding SentAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                    <DataGridTextColumn Header="Lu" Binding="{Binding IsRead}" Width="70"/>
                    <DataGridTemplateColumn Header="Actions" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding Id}" Content="Consulter" Style="{DynamicResource ConsulterButton}" Padding="8,4" Click="Open_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
