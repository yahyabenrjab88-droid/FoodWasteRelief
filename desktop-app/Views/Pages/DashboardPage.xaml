<Page x:Class="FoodWasteRelief.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{StaticResource PageBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <TextBlock Text="{Binding WelcomeText}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,16" Foreground="{StaticResource TextSecondaryBrush}"/>

            <WrapPanel Margin="0,0,0,12">
                <Border Style="{StaticResource CardBorder}" Width="250" Margin="0,0,12,12" Background="{StaticResource KpiCard1Brush}">
                    <StackPanel>
                        <TextBlock Text="Utilisateurs" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalUsers}" FontSize="36" FontWeight="Light"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="250" Margin="0,0,12,12" Background="{StaticResource KpiCard2Brush}">
                    <StackPanel>
                        <TextBlock Text="En attente" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding PendingApprovals}" FontSize="36" FontWeight="Light"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="250" Margin="0,0,12,12" Background="{StaticResource KpiCard3Brush}">
                    <StackPanel>
                        <TextBlock Text="Produits actifs" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ProductsCount}" FontSize="36" FontWeight="Light"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="250" Margin="0,0,12,12" Background="{StaticResource KpiCard4Brush}">
                    <StackPanel>
                        <TextBlock Text="Repas sauves" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalMealsDonated}" FontSize="36" FontWeight="Light"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Impact environnemental (Business + Association) -->
            <Border Style="{StaticResource CardBorder}" Visibility="{Binding ImpactLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Impact environnemental" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Width="180" Height="6" IsIndeterminate="True"/>
                        <TextBlock Text="Chargement..." Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Visibility="{Binding ImpactError, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Impact environnemental" Style="{StaticResource SectionHeader}"/>
                    <Border Background="#F8D7DA" BorderBrush="#F5C2C7" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <TextBlock Text="{Binding ImpactErrorText}" Foreground="#842029" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Visibility="{Binding ImpactEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Impact environnemental" Style="{StaticResource SectionHeader}"/>
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16" Background="White">
                        <StackPanel>
                            <TextBlock Text="Aucune donnée pour l'instant. Commencez à vendre ou donner pour voir votre impact !" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Business impact section -->
            <Border Style="{StaticResource CardBorder}" Visibility="{Binding IsBusinessView, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Visibility="{Binding ImpactEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Impact environnemental" Style="{StaticResource SectionHeader}"/>

                    <WrapPanel Margin="0,0,0,12">
                        <!-- Card 1 -->
                        <Border Width="260" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ImpactTotalKg, StringFormat={}{0:0.#} kg}" FontSize="28" FontWeight="Bold" Foreground="#2D6A4F"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="kg sauvés du gaspillage" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text=" (estimation)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding ImpactIsEstimation, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Leaf icon -->
                                <Viewbox Grid.Column="1" Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#2D6A4F" StrokeThickness="2" Fill="Transparent"
                                              Data="M12,2 C6,6 5,12 5,18 C11,19 18,15 20,8 C16,7 14,5 12,2 Z"/>
                                        <Path Stroke="#2D6A4F" StrokeThickness="2" Fill="Transparent"
                                              Data="M9,14 C11,12 14,10 18,8"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- Card 2 -->
                        <Border Width="260" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ImpactMeals}" FontSize="28" FontWeight="Bold" Foreground="#52B788"/>
                                    <TextBlock Text="repas estimés" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Stroke="#52B788" StrokeThickness="2" Width="18" Height="18" Canvas.Left="3" Canvas.Top="3"/>
                                        <Ellipse Fill="#52B788" Width="2" Height="2" Canvas.Left="11" Canvas.Top="11"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- Card 3 -->
                        <Border Width="260" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ImpactCo2, StringFormat={}{0:0.#}}" FontSize="28" FontWeight="Bold" Foreground="#1B4332"/>
                                    <TextBlock Text="kg CO2 évités" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#1B4332" StrokeThickness="2" Fill="Transparent"
                                              Data="M7,16 C4,16 3,14 3,12 C3,10 5,9 7,9 C8,6 10,5 12,5 C15,5 17,7 17,10 C19,10 21,11 21,13 C21,15 20,16 18,16 Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- Card 4 -->
                        <Border Width="260" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ImpactDonationsCount}" FontSize="28" FontWeight="Bold" Foreground="#52B788"/>
                                    <TextBlock Text="dons acceptés" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#52B788" StrokeThickness="2" Fill="Transparent"
                                              Data="M12,20 C12,20 4,14 4,9 C4,6.5 6,5 8,5 C9.5,5 11,6 12,7.5 C13,6 14.5,5 16,5 C18,5 20,6.5 20,9 C20,14 12,20 12,20 Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </WrapPanel>

                    <!-- Monthly goal -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Objectif du mois : 50 kg sauvés" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ImpactMonthKg, StringFormat={}{0:0.#} kg}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <ProgressBar Height="12" Maximum="50" Value="{Binding ImpactMonthKg}" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ImpactGoalHit, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="✓" Foreground="#2D6A4F" FontWeight="Bold" Margin="0,0,6,0"/>
                                <TextBlock Text="Objectif atteint !" Foreground="#2D6A4F" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Monthly bars -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Évolution mensuelle des kg sauvés" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Canvas x:Name="BusinessMonthlyCanvas" Height="200"/>
                            </StackPanel>
                        </Border>

                        <!-- Split -->
                        <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Origine des kg sauvés" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Canvas x:Name="BusinessSplitCanvas" Height="50"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="■" Foreground="#2D6A4F" Margin="0,0,6,0"/>
                                    <TextBlock Text="Dons" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                                    <TextBlock Text="■" Foreground="#52B788" Margin="0,0,6,0"/>
                                    <TextBlock Text="Ventes" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Association impact section -->
            <Border Style="{StaticResource CardBorder}" Visibility="{Binding IsAssociationView, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Visibility="{Binding ImpactEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Impact environnemental" Style="{StaticResource SectionHeader}"/>

                    <WrapPanel Margin="0,0,0,12">
                        <Border Width="260" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding AssocReceivedKg, StringFormat={}{0:0.#} kg}" FontSize="28" FontWeight="Bold" Foreground="#2D6A4F"/>
                                <TextBlock Text="kg reçus en dons" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Width="260" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding AssocCollectedKg, StringFormat={}{0:0.#} kg}" FontSize="28" FontWeight="Bold" Foreground="#52B788"/>
                                <TextBlock Text="kg effectivement collectés" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Width="260" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding AssocMeals}" FontSize="28" FontWeight="Bold" Foreground="#1B4332"/>
                                <TextBlock Text="repas estimés distribués" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Width="260" Margin="0,0,12,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding AssocCo2, StringFormat={}{0:0.#}}" FontSize="28" FontWeight="Bold" Foreground="#52B788"/>
                                <TextBlock Text="kg CO2 évités" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            Visibility="{Binding AssocHasReceived, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Taux de collecte" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding AssocCollectRate, StringFormat={}{0}% des dons ont été collectés}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <ProgressBar Height="12" Maximum="100" Value="{Binding AssocCollectRate}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Dons reçus par mois" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Canvas x:Name="AssocMonthlyCanvas" Height="200"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Top entreprises donatrices" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Canvas x:Name="AssocTopCanvas" Height="160"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Activite recente" Style="{StaticResource SectionHeader}"/>
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,4,0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
