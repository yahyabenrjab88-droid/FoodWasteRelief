<Page x:Class="FoodWasteRelief.Views.Pages.ClientCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <TextBox x:Name="SearchBox" Width="280" Style="{StaticResource ModernTextBox}"
                         materialDesign:HintAssist.Hint="Rechercher"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="CategoryFilterBox" Width="200" Margin="12,0,0,0" Style="{StaticResource ModernComboBox}"
                          SelectionChanged="CategoryFilterBox_SelectionChanged">
                    <ComboBoxItem Content="Toutes les catégories" IsSelected="True" Tag=""/>
                </ComboBox>
                <ComboBox x:Name="SortBox" Width="200" Margin="12,0,0,0" Style="{StaticResource ModernComboBox}"
                          SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="Expiration (proche)" Tag="exp" IsSelected="True"/>
                    <ComboBoxItem Content="Prix croissant" Tag="prix_asc"/>
                    <ComboBoxItem Content="Prix décroissant" Tag="prix_desc"/>
                    <ComboBoxItem Content="Nom (A–Z)" Tag="nom"/>
                </ComboBox>
                <Button Content="Actualiser" Style="{StaticResource OutlineButton}" Margin="12,0,0,0" Click="RefreshBtn_Click"/>
            </DockPanel>
        </Border>

        <Border x:Name="CatalogErrorBanner" Grid.Row="1" Visibility="Collapsed" Padding="12,8" Margin="0,0,0,10"
                Background="#F8D7DA" BorderBrush="#F5C2C7" BorderThickness="1" CornerRadius="6">
            <TextBlock x:Name="CatalogErrorText" Foreground="#842029" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CatalogItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="268" Margin="0,0,12,12" Padding="14" Style="{StaticResource CardBorder}" MouseLeftButtonUp="CatalogCard_MouseLeftButtonUp">
                            <StackPanel>
                                <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="15"/>
                                <TextBlock Text="{Binding BusinessName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Categorie}" FontSize="11" Margin="0,6,0,0" Opacity="0.85"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Prix, StringFormat={}{0:F2}}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" TND" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Expire le "/>
                                    <Run Text="{Binding DateExpiration, StringFormat=dd/MM/yyyy}"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Stock : "/>
                                    <Run Text="{Binding Quantite}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Consulter" Tag="{Binding Id}" Style="{StaticResource ConsulterButton}" Padding="8,4" Click="ViewProduct_Click"/>
                                </StackPanel>
                                <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                    <TextBox Width="56" Height="34" Text="1" VerticalContentAlignment="Center"
                                             Style="{StaticResource ModernTextBox}" DockPanel.Dock="Left"/>
                                    <Button Content="Ajouter au panier" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                            Tag="{Binding Id}" Click="AddToCart_Click" DockPanel.Dock="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
