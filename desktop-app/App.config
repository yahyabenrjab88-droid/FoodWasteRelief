<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="CloudinaryCloudName" value="YOUR_CLOUD_NAME" />
    <add key="CloudinaryUploadPreset" value="YOUR_UNSIGNED_UPLOAD_PRESET" />
  </appSettings>
  <connectionStrings>
    <add name="FoodWasteDB"
         connectionString="Server=127.0.0.1;Port=3306;Database=foodwaste_db;Uid=root;Pwd=;CharSet=utf8mb4;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
